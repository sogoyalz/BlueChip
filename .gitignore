# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Production builds ----
build/
dist/

# ---- Testing ----
coverage/

# ---- Environment / secrets ----
# Never commit real env files. Use .env.example to document required keys.
.env
.env.*
!.env.example

# Credential material. *.pem was already covered below; these are the rest of
# the shapes that leak by accident. .npmrc in particular routinely holds a
# registry auth token — if you ever need a token-free one committed for CI,
# add it with `git add -f`.
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
.npmrc
.netrc

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# ---- OS / editor cruft ----
.DS_Store
*.pem
.vscode/
.idea/


# mongodb-memory-server binaries (downloaded on demand)
.mongodb-binaries/

# ---- Local tooling / editor-agent config ----
# Machine-specific: hook commands, MCP server definitions, launch ports and
# assistant rules. These belong to whoever is working on the repo, not to the
# repo. An earlier set of them was committed and later deleted, which is what
# these rules prevent recurring. (Deleting them did not remove them from
# history — they are still fetchable from the public repo, harmlessly: they
# only ever held local command config, never credentials.)
.claude/
.mcp.json
.windsurfrules
.cursorrules
.cursor/
.aider*
AGENTS.md
.github/copilot-instructions.md
